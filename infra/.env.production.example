# .env de PRODUÇÃO (S4.3). Na VM fica em /opt/cybercorp/.env, permissão 600, dono deploy. Nunca vai para o repositório.
# Cada segredo é gerado na hora, um por linha:   openssl rand -hex 32
# O compose recusa subir sem os segredos (${VAR:?}) e o sync recusa senha de dashboard curta: nada cai num valor de dev.

# Domínio: sslip.io resolve <ip-com-hifens>.sslip.io (e a., b., sync.) para o IP, sem cadastro
DOMAIN=203-0-113-10.sslip.io

# Imagens publicadas pelo workflow deploy-prod (o deploy troca o IMAGE_TAG a cada release)
IMAGE_PREFIX=ghcr.io/bossburgues/desafioteccybercorp
IMAGE_TAG=prod

# Postgres do sync (só na rede interna do compose)
POSTGRES_PASSWORD=

# Sistema A
A_TIMEZONE=America/Sao_Paulo
A_APP_TOKEN=
A_UI_APP_TOKEN=
A_TECNICO_PASSWORD=
A_ESTAGIARIO_PASSWORD=
A_SYNC_BOT_TOKEN=
# Assinatura do webhook A → sync (mesmo valor nos dois lados, mínimo 16 caracteres)
HMAC_SECRET=

# Sistema B: o caos começa desligado e é ligado ao vivo pelo dashboard. /admin fica bloqueado no Caddy
B_ADMIN_TOKEN=

# Dashboard do sync (S5.3): login HTTP Basic sobre HTTPS. Senha com 12+ caracteres. Sem os dois, o dashboard não sobe
DASHBOARD_USER=operador
DASHBOARD_PASSWORD=
DASHBOARD_CONTROLS=true

LOG_LEVEL=info
