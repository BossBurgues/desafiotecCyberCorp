    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "zod": "4.6.5"
  }
}
