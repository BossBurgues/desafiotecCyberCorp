# Variáveis de ambiente de desenvolvimento — NÃO USE EM PRODUÇÃO.
# Em NODE_ENV=production, todas as credenciais abaixo são obrigatórias (sem fallback).

# Sistema A (mock GLPI)
PORT=3001
A_TIMEZONE=America/Sao_Paulo
A_DB_PATH=./data/system-a.db
A_APP_TOKEN=dev-app-token
A_UI_APP_TOKEN=dev-ui-app-token
A_TECNICO_PASSWORD=dev-tecnico-password
A_ESTAGIARIO_PASSWORD=dev-estagiario-password
A_SYNC_BOT_TOKEN=dev-sync-bot-token
A_TRUST_PROXY=false
A_WEBHOOK_ENABLED=true
A_WEBHOOK_URL=http://localhost:3000/webhooks/system-a
A_WEBHOOK_DROP_RATE=0
HMAC_SECRET=dev-hmac-secret-troque-em-producao-0000

# Sistema B (caixa-preta instável)
ASPNETCORE_URLS=http://0.0.0.0:5002
B_DB_PATH=./data/system-b.db
B_ADMIN_TOKEN=dev-b-admin-token
# Caos (tudo 0 = desligado). Taxas de 0 a 1, soma das taxas de falha <= 1. Veja apps/system-b/README.md
B_CHAOS_SEED=
B_CHAOS_LATENCY_MS=0
B_CHAOS_ERROR_RATE=0
B_CHAOS_TIMEOUT_RATE=0
B_CHAOS_TIMEOUT_MS=30000
B_CHAOS_COMMIT_THEN_FAIL_RATE=0
B_CHAOS_ACK_WITHOUT_PERSIST_RATE=0
B_CHAOS_OK_WITH_ERROR_BODY_RATE=0
B_CHAOS_RATE_LIMIT_RATE=0
B_CHAOS_TRUNCATE_TEXT=0
B_CHAOS_PAGE_REPEAT_RATE=0
B_CHAOS_PAGE_SKIP_RATE=0
B_CHAOS_LIST_DELAY_MS=0
B_CHAOS_FORMAT_DRIFT=false

# Sync Service (escuta em PORT, padrão 3000; rodando junto com o A, passe PORT=3000 só para o sync)
DATABASE_URL=postgres://sync:dev-sync-password@localhost:5432/sync
A_BASE_URL=http://localhost:3001
B_BASE_URL=http://localhost:5002
LOG_LEVEL=info
READY_CHECK_TIMEOUT_MS=2000
READY_CHECK_INTERVAL_MS=5000
WORKER_POLL_INTERVAL_MS=1000
B_TIMEOUT_MS=5000
B_BREAKER_THRESHOLD=5
B_BREAKER_OPEN_MS=30000
QUEUE_LEASE_MS=60000
QUEUE_BACKOFF_BASE_MS=1000
QUEUE_BACKOFF_MAX_MS=300000
QUEUE_TRANSIENT_MAX_AGE_MS=86400000
QUEUE_PERMANENT_MAX_ATTEMPTS=3
WORKER_MAX_JOBS_PER_TICK=20
# O sync usa A_APP_TOKEN, A_SYNC_BOT_TOKEN, A_TIMEZONE e HMAC_SECRET definidos acima (entra no A como sync-bot)
A_TIMEOUT_MS=5000
A_LOOKUPS_TTL_MS=60000
B_TO_A_ENABLED=true
B_SCAN_INTERVAL_MS=30000
B_MARKER_FIELD=description
CREATE_UNCERTAIN_SCANS=2
B_LIST_PAGE_SIZE=100
VERIFY_AFTER_WRITE=true
WEBHOOK_REPLAY_WINDOW_MS=300000
POLL_INTERVAL_MS=10000
POLL_OVERLAP_MS=120000
POLL_PAGE_SIZE=100
# Dashboard em /dashboard, com login (HTTP Basic). Sem usuário e senha (mín. 12 caracteres) o dashboard não sobe.
# O painel de caos usa o B_ADMIN_TOKEN acima. true liga reprocessar e caos (só para quem passou pelo login)
DASHBOARD_USER=operador
DASHBOARD_PASSWORD=troque-esta-senha-local
DASHBOARD_CONTROLS=true

# Docker Compose (infra/docker-compose.yml). As variáveis acima que são caminhos/URLs locais são fixadas pelo compose
POSTGRES_PASSWORD=dev-sync-password
DOMAIN=localhost
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
